<div class="location_coperate"><%- include('../components/location_coperate', { htmlExt: htmlExt }) %></div>

<script src="https://apis.openapi.sk.com/tmap/jsv2?version=1&appKey=eXK3n08TZ64hKTzFsRqJsVaGckQctZJaXcsy9hQi"></script>
<script src="<%= basePath %>js/location_coperate.js"></script>
<script src="<%= basePath %>js/nav.js"></script>
<script src="<%= basePath %>js/aos.js"></script>
<script>
    function isMobile() {
        const userAgent = navigator.userAgent || navigator.vendor || window.opera;
        // 모바일 기기 키워드 확인!
        return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(userAgent);
    }

    // 페이지 로드 완료되면 실행
    window.onload = function () {
        if (isMobile()) {
            // 앗, 모바일 기기로 접속했네?
            alert("데스크탑으로 확인하시기바랍니다!");

            // 얼럿창 띄운 다음에 바로 페이지 내용을 안 보이게 하는 거야.
            // body 태그 전체를 숨겨버리면 화면이 하얗게 변할 거야!
            document.body.style.display = "none";

            // 만약 특정 부분만 숨기고 싶다면
            // document.getElementById('숨기고 싶은 요소의 id').style.display = 'none';
            // 이렇게 해도 돼!
        }
        // 만약 모바일이 아니면, 아무 일도 일어나지 않고 페이지는 정상적으로 보일 거야.
    };
</script>
<script>
    AOS.init();
</script>
