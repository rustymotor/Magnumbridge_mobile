        <script>
            $("#resumeFile").on('change', function () {
            var fileName = $(this).val().split('\\').pop();
            $(this).siblings(".upload-name").val(fileName);
            });

            $("#portfolioFile").on('change', function () {
            var fileName = $(this).val().split('\\').pop();
            $(this).siblings(".upload-name").val(fileName);
            });

            function openPopup() {
            document.getElementById('application').style.display = 'block';
            }

            function closeMap() {
            document.getElementById('application').style.display = 'none';
            }

            function openPopup2() {
            document.getElementById('privacy_policy_terms').style.display = 'block';
            }

            function closeMap2() {
            document.getElementById('privacy_policy_terms').style.display = 'none';
