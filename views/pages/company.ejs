        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script>
$(document).ready(function () {
    const $qnaboard = $(".qnaboard");

    function showNotice(index) {
        $qnaboard.removeClass("active").hide();
        $qnaboard.eq(index).addClass("active").show();
    }

    // 초기화
    $qnaboard.hide().removeClass("active");
    $("#qnaboard01").show().addClass("active");

    // 작성하기 버튼 클릭 시 -> qnaboard03로 이동
    $(".write").click(function () {
        showNotice(2); // qnaboard03
    });

    // 목록으로 버튼 클릭 시 -> qnaboard01로 이동
    $(".board:contains('목록으로')").click(function () {
        showNotice(0); // qnaboard01
    });

    // 제목 클릭 시 -> qnaboard02로 이동
    $(".ta-left").click(function () {
        showNotice(1); // qnaboard02
    });

    // 작성완료 버튼 클릭 시 -> qnaboard01로 이동
    $(".complete").click(function () {
        showNotice(0); // qnaboard01
    });

    // 돌아가기 버튼 클릭 시 -> qnaboard01로 이동
    $(".normal:contains('돌아가기')").click(function () {
        showNotice(0); // qnaboard01
    });

    // 이전글, 다음글 예시 처리 (필요 시 로직 추가)
    $(".normal:contains('이전글')").click(function () {
        showNotice(1); // qnaboard02
    });

    $(".normal:contains('다음글')").click(function () {
        showNotice(1); // qnaboard02
    });
});
</script>
