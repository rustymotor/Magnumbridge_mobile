<!DOCTYPE html>
<html lang="ko">
    <head>
        <%- include('../partials/head') %>
    </head>
    <body>
        <div class="container company">
            <header><%- include('../partials/header', { htmlExt: htmlExt }) %></header>
            <div class="spacer_top_visual company_2">
                <h1 class="h1">
                    Company
                    <p class="subtitle">We are talking about trust, creativity, and innovation through technology.</p>
                </h1>
                <div class="visual_gradient">
                    <h2 class="h2">Customer & Partner</h2>
                </div>
            </div>
            <main>
                <!-- 컨텐츠 영역 -->
                <p class="subtxt">“매그넘브릿지”와 함께하는 고객과 파트너를 소개합니다.</p>
                <section class="fullback partner">
                    <div class="box-list-area fc-white">
                        <div class="list nomargin">
                            <h3 class="h3 tac">Partner</h3>
                            <div class="type2 mt-10">
                                <div class="type2" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="100">
                                    <div class="logo_line">
                                        <span class="flex_center"
                                            ><img src="<%= basePath %>/images/company/logo_tmax.png" class="rs70" alt="티맥스소프트 로고"
                                        /></span>
                                    </div>
                                    <div class="ml-3 flex_middle">
                                        <p class="title">티맥스소프트</p>
                                        <ul class="list-small">
                                            <li>
                                                <a href="https://www.tmaxsoft.com" target="_blank"
                                                    >https://www.tmaxsoft.com</a
                                                >
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div>
                                    <div class="type2"data-aos="fade-right" data-aos-duration="1000" data-aos-delay="200">
                                        <div class="logo_line">
                                            <span class="flex_center"
                                                ><img src="<%= basePath %>/images/company/logo_webare.png" class="rs70" alt="위베어소프트 로고"
                                            /></span>
                                        </div>
                                        <div class="ml-3 flex_middle">
                                            <p class="title">위베어소프트</p>
                                            <ul class="list-small">
                                                <li>
                                                    <a href="https://www.webaresoft.com" target="_blank"
                                                        >https://www.webaresoft.com</a
                                                    >
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="type2">
                                <div class="type2"data-aos="fade-left" data-aos-duration="1000" data-aos-delay="300">
                                    <div class="logo_line">
                                        <span class="flex_center"
                                            ><img src="<%= basePath %>/images/company/logo_synap.svg" class="rs70" alt="사이냅소프트 로고"
                                        /></span>
                                    </div>
                                    <div class="ml-3 flex_middle">
                                        <p class="title">사이냅소프트</p>
                                        <ul class="list-small">
                                            <li>
                                                <a href="https://www.synapsoft.co.kr" target="_blank"
                                                    >https://www.synapsoft.co.kr</a
                                                >
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div>
                                    <div class="type2"data-aos="fade-right" data-aos-duration="1000" data-aos-delay="400">
                                        <div class="logo_line">
                                            <span class="flex_center"
                                                ><img src="<%= basePath %>/images/company/logo_applied.svg" class="rs70" alt="어플라이드소프트 로고"
                                            /></span>
                                        </div>
                                        <div class="ml-3 flex_middle">
                                            <p class="title">어플라이드소프트</p>
                                            <ul class="list-small">
                                                <li>
                                                    <a href="https://www.appliedsoft.co.kr" target="_blank"
                                                        >https://www.appliedsoft.co.kr</a
                                                    >
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="list">
                    <div class="fullback bg_gray">
                        <div class="pad-10">
                            <h3 class="h3 tac fc-primary">Customer</h3>
                            <div class="slide_slow mt-7"><%- include('../components/swiper_sub_1') %></div>                            
                        </div>
                        
                    </div>                    
                </section>
                <!-- // 컨텐츠 영역 -->
            </main>
            <footer id="footer"><%- include('../partials/footer') %></footer>
        </div>
        <script src="<%= basePath %>js/slideSlow.js"></script>
    </body>
</html>
