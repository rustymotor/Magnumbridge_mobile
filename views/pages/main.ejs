<!DOCTYPE html>
<html lang="ko">
    <head>
        <%- include('../partials/head') %>
    </head>
    <body class="is-main">
        <div class="container main">
            <header><%- include('../partials/header', { htmlExt: htmlExt }) %></header>

            <div class="spacer_top_visual" aria-hidden="true">
                <!-- 스와이퍼1 -->
                <%- include('../components/swiper_main_1', { htmlExt: htmlExt }) %>
                <!-- /스와이퍼1 -->
            </div>
            <main>
                <!-- 컨텐츠 영역 -->
                <section class="company">
                    <h2 class="section_title">Company Overview</h2>
                    <p class="section_description">
                        자체 개발한 “All4Frame” 제품을 바탕으로, 고객의 지속 가능 경영을 위해 함께 성장해 나가는 IT
                        솔루션 기업입니다.
                    </p>
                    <button type="button" onclick="window.location.href='company_1<%= htmlExt %>'">
                        About Magnumbridge
                    </button>
                    <ul>
                        <li data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
                            <p>Vision & Mission</p>
                            <dl>
                                <dt>Vision & <br />Mission</dt>
                                <dd>매그넘브릿지<br />비전과 미션</dd>
                                <dd>
                                    <a href="company_3<%= htmlExt %>" type="button">
                                        <span href="#none"
                                            ><img
                                                src="<%= basePath %>images/main/company_arrow.svg"
                                                alt="매그넘브릿지 비전과 미션"
                                        /></span>
                                    </a>
                                </dd>
                            </dl>
                        </li>
                        <li data-aos="fade-down" data-aos-duration="1000" data-aos-delay="200">
                            <p>Customer & Partner</p>
                            <dl>
                                <dt>Customer & <br />Partner</dt>
                                <dd>매그넘브릿지<br />고객과 파트너</dd>
                                <dd>
                                    <a href="company_2<%= htmlExt %>" type="button">
                                        <span href="#none"
                                            ><img
                                                src="<%= basePath %>images/main/company_arrow.svg"
                                                alt="매그넘브릿지 고객과 파트너"
                                        /></span>
                                    </a>
                                </dd>
                            </dl>
                        </li>
                        <li data-aos="fade-up" data-aos-duration="1000" data-aos-delay="300">
                            <p>Ideal Employee</p>
                            <dl>
                                <dt>Ideal & <br />Employee</dt>
                                <dd>매그넘브릿지<br />인재상</dd>
                                <dd>
                                    <a href="recruit_1<%= htmlExt %>" type="button">
                                        <span href="#none"
                                            ><img
                                                src="<%= basePath %>images/main/company_arrow.svg"
                                                alt="매그넘브릿지 인재상"
                                        /></span>
                                    </a>
                                </dd>
                            </dl>
                        </li>
                        <li data-aos="fade-down" data-aos-duration="1000" data-aos-delay="400">
                            <p>History</p>
                            <dl>
                                <dt>History</dt>
                                <dd>매그넘브릿지<br />발자취</dd>
                                <dd>
                                    <a href="company_4<%= htmlExt %>" type="button">
                                        <span href="#none"
                                            ><img
                                                src="<%= basePath %>images/main/company_arrow.svg"
                                                alt="매그넘브릿지 발자취"
                                        /></span>
                                    </a>
                                </dd>
                            </dl>
                        </li>
                    </ul>
                </section>
                <section>
                    <h2 class="section_title">Tech Overview</h2>
                    <p class="section_description">
                        풍부한 경험과 전문성을 바탕으로 고객의 요구사항을 효과적으로 수행할 수 있는 프레임워크
                        "All4Frame"을 제공합니다.
                    </p>
                </section>
                <section class="visual_accordion section">
                    <!-- 아코디언 -->
                    <%- include('../components/visaul_accordion') %>
                    <!-- /아코디언 -->
                </section>
                <section class="section">
                    <!-- 스와이퍼2 -->
                    <%- include('../components/swiper_main_2', { htmlExt: htmlExt }) %>
                    <!-- /스와이퍼1 -->
                </section>
                <!-- // 컨텐츠 영역 -->
            </main>
            <footer id="footer"><%- include('../partials/footer') %></footer>
        </div>
        <script src="<%= basePath %>js/swiper/swiper-bundle.min.js"></script>
        <script src="<%= basePath %>js/swiper_mainpage.js"></script>
        <script src="<%= basePath %>js/visual_main_accordion.js"></script>
    </body>
</html>
